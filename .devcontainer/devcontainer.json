{
  "name": "GenAI Workshop — Banking Capstone",

  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // NO "features" block on purpose.
  // The universal image already ships Java 21, Maven, Node 20 and gh.
  // Every devcontainer feature is a script that runs at build time and can
  // fail — which is exactly what happened with the node feature on
  // ubuntu-24.04. Zero features means zero feature failures, and universal
  // is the image Codespaces caches by default, so builds are fast.

  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "vscjava.vscode-java-pack",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "editor.fontSize": 15,
        "terminal.integrated.fontSize": 14,
        "workbench.startupEditor": "readme",
        "git.autofetch": true,

        // Agent mode must ask before running commands —
        // supervised permissions are a teaching point in Demo 5.
        "chat.tools.autoApprove": false
      }
    }
  },

  "forwardPorts": [8080, 5173],
  "portsAttributes": {
    "8080": { "label": "API", "onAutoForward": "notify" },
    "5173": { "label": "Web", "onAutoForward": "openPreview" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "codespace"
}
