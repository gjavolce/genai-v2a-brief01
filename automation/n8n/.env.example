# Copy this file to .env. Use absolute paths.
PAYFLOW_RUNS_DIR=/Users/your-name/payflow-n8n-runs
PAYFLOW_REMOTE_URL=https://github.com/gjavolce/genai-v2a-brief01.git
PAYFLOW_RUNNER_TOKEN=replace-with-a-long-random-token
PAYFLOW_RUNNER_URL=http://host.docker.internal:5680
PAYFLOW_RUNNER_HOST=127.0.0.1
PAYFLOW_RUNNER_PORT=5680

# Which CLI runs the roles: codex or claude.
# codex drives .agents/ and .codex/. claude drives the canonical .claude/.
PAYFLOW_ENGINE=codex
PAYFLOW_ENGINE_BIN=/opt/homebrew/bin/codex
PAYFLOW_ENGINE_MODEL=gpt-5.6-sol

# Claude engine only. Codex sandboxes the filesystem; Claude does not, so these
# permission flags plus the throwaway clone and the ownership check are the guard.
# PAYFLOW_CLAUDE_READ_ARGS=--permission-mode acceptEdits --disallowed-tools Edit Write NotebookEdit
# PAYFLOW_CLAUDE_WRITE_ARGS=--permission-mode acceptEdits

# Set this to a Header Auth credential ID to keep the token out of n8n expressions.
# Then set N8N_BLOCK_ENV_ACCESS_IN_NODE to true in compose.yml. See README.md.
# PAYFLOW_N8N_CREDENTIAL_ID=

N8N_ENCRYPTION_KEY=replace-with-a-second-long-random-token
GENERIC_TIMEZONE=Europe/London
